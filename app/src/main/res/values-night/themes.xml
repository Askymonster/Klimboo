<resources>
    <style name="Base.Theme.Klimboo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="colorPrimary">@color/royal_blue</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="RoundedCorners" parent="">
        <item name="cornerSize">12dp</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="TextInputStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@drawable/text_input_style</item>
        <item name="android:textColorHint">@color/white</item>
        <item name="hintTextColor">@drawable/text_input_style</item>
    </style>

    <color name="buttonsTint">@color/white</color>
</resources>